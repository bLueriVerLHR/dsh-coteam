{
  "name": "@blueriverlhr/dsh-coteam-preset",
  "description": "dsh-coteam preset subpackage: team-leader (小组长模式) + team-member (小组成员模式) agent presets, synced into ~/.dsh/.agent-presets on startup by the host half.",
  "version": "0.4.0",
  "private": true,
  "license": "GPL-3.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bLueriVerLHR/dsh-coteam.git"
  },
  "homepage": "https://github.com/bLueriVerLHR/dsh-coteam",
  "bugs": {
    "url": "https://github.com/bLueriVerLHR/dsh-coteam/issues"
  },
  "type": "commonjs",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./presets/*": "./presets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "presets",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs .",
    "test": "node --test tests/*.test.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=18"
  }
}
